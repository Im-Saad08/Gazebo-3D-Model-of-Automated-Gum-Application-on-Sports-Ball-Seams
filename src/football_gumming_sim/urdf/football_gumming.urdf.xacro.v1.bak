    <origin xyz="0 0 0.80"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.8" effort="200" velocity="0.5"/>
    <dynamics damping="2.0" friction="0.1"/>
  </joint>
  <link name="left_cup">
