  <joint name="rail_mount" type="fixed">
    <parent link="base_link"/><child link="nozzle_rail"/><origin xyz="0 0 1.35"/>
  </joint>
  <link name="z_carriage">
    <inertial><mass value="1.0"/><inertia ixx="0.002967" ixy="0" ixz="0" iyy="0.002967" iyz="0" izz="0.001667"/></inertial>
    <visual><geometry><box size="0.1 0.1 0.16"/></geometry><material name="rail_silver"/></visual>
    <collision><geometry><box size="0.1 0.1 0.16"/></geometry></collision>
