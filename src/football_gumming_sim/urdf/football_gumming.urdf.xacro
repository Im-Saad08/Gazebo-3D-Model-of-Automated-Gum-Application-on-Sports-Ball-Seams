  <joint name="reclamp_joint" type="revolute">
    <parent link="left_cup"/><child link="football"/><origin xyz="0.118 0 0"/>
    <axis xyz="0.000000 -0.074675 0.997208"/>
    <limit lower="0" upper="1.4021" effort="50" velocity="0.8"/>
    <dynamics damping="1.0" friction="0.05"/>
  </joint>
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="z_axis_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="tilt_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="left_cup_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_cup_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="reclamp_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find football_gumming_sim)/config/controllers.yaml</parameters>
      <position_proportional_gain>0.4</position_proportional_gain>
    </plugin>
  </gazebo>
  <gazebo reference="z_carriage"><gravity>false</gravity></gazebo>
  <gazebo reference="nozzle_body"><gravity>false</gravity></gazebo>
</robot>
